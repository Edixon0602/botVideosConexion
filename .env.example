# ==========================================
# CONFIGURACIÓN DEL BOT DE TELEGRAM
# ==========================================
TELEGRAM_TOKEN=tu_token_aqui
API_ID=tu_api_id_aqui
API_HASH=tu_api_hash_aqui

# Chat ID donde se envían las alertas y opciones de borrado programado
NOTIFICATION_CHAT_ID=tu_chat_id_aqui,otro_chat_id

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR FTP
# ==========================================
FTP_HOST=tu_host_ftp
FTP_USER=tu_usuario_ftp
FTP_PASS=tu_password_ftp
FTP_UPLOAD_PATH=avances-informativos

# ==========================================
# CONFIGURACIÓN DEL PANEL WEB (FLASK)
# ==========================================
ADMIN_USER=admin
ADMIN_PASSWORD=admin
PORT=8080

# ==========================================
# CONFIGURACIÓN VDO PANEL (OPCIONAL)
# ==========================================
VDOPANEL_USER=tu_vdo_user
VDOPANEL_PASS=tu_vdo_pass
VDOPANEL_PLAYLIST_ID=2
VDOPANEL_PLAYLIST_NAME=MUSICANEW
VDOPANEL_HOST=stream.conexion.com.ve
VDOPANEL_SCHEDULER_ID=2

# ==========================================
# CONFIGURACIÓN DROPBOX (EXTRACCIÓN DE AUDIO)
# ==========================================
DROPBOX_APP_KEY=tu_dropbox_app_key
DROPBOX_APP_SECRET=tu_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=tu_dropbox_refresh_token
DROPBOX_FOLDER=/CNX-INFORMATIVA

# ==========================================
# CONFIGURACIÓN INSTAGRAM (REELS AUTOMATIZADOS)
# ==========================================
INSTAGRAM_ACCOUNT_ID=tu_instagram_account_id
INSTAGRAM_ACCESS_TOKEN=tu_instagram_access_token
# True para modo prueba (valida el video en Meta sin publicarlo), False para publicar en vivo
INSTAGRAM_DRY_RUN=True

# ==========================================
# CONFIGURACIÓN YOUTUBE (SUBIDA DE VIDEOS)
# ==========================================
# Credencial de Google Cloud de tipo "TVs and Limited Input devices".
# Es la que permite vincular el canal con un código, sin redirect URI.
YOUTUBE_DEVICE_CLIENT_ID=tu_youtube_device_client_id
YOUTUBE_DEVICE_CLIENT_SECRET=tu_youtube_device_client_secret
YOUTUBE_REFRESH_TOKEN=tu_youtube_refresh_token
# Opcional: credencial de app de escritorio/web (solo para flujos alternativos)
# YOUTUBE_CLIENT_ID=tu_youtube_client_id
# YOUTUBE_CLIENT_SECRET=tu_youtube_client_secret
# Opcional: solo si no tienes refresh token (caduca en ~1 hora)
# YOUTUBE_ACCESS_TOKEN=tu_youtube_access_token
# Opcional: se muestran en /conectar_youtube y /redes
# YOUTUBE_CHANNEL_HANDLE=@MiCanal
# YOUTUBE_ACCOUNT_EMAIL=cuenta@gmail.com
# public | unlisted | private
YOUTUBE_PRIVACY_STATUS=public
# 25 = News & Politics
YOUTUBE_CATEGORY_ID=25
# Agrega #Shorts a videos verticales de hasta 3 minutos
YOUTUBE_ADD_SHORTS_HASHTAG=True
# Ruta del archivo de cookies de YouTube (por defecto cookies.txt)
# YOUTUBE_COOKIES_FILE=cookies.txt
# Proxy opcional para descargas desde VPS bloqueados
# YOUTUBE_PROXY=http://usuario:clave@host:puerto
# Opción gratuita con Tor instalado en el VPS:
# YOUTUBE_PROXY=socks5h://172.18.0.1:9050
# Ruta de Deno si no está en el PATH
# YOUTUBE_DENO_PATH=/usr/local/bin/deno
# La API externa loader.to queda desactivada por defecto (poco confiable)
YOUTUBE_EXTERNAL_API_ENABLED=False
# Clientes de yt-dlp a probar, uno por intento. web_embedded/mweb son los que
# mejor funcionan desde VPS. Para probar otro orden, sepáralos por coma.
YOUTUBE_PLAYER_CLIENTS=web_embedded,mweb,tv,web,android_vr

# ==========================================
# CONFIGURACIÓN TIKTOK (CONTENT POSTING API)
# ==========================================
TIKTOK_CLIENT_KEY=tu_tiktok_client_key
TIKTOK_CLIENT_SECRET=tu_tiktok_client_secret
TIKTOK_REFRESH_TOKEN=tu_tiktok_refresh_token
# Opcional: se usa si todavía no hay refresh token
# TIKTOK_ACCESS_TOKEN=tu_tiktok_access_token
# Solo si usas TIKTOK_ACCESS_TOKEN: scopes que tiene ese token
# TIKTOK_ACCESS_SCOPE=video.upload,user.info.basic
# Opcional: identifica la cuenta autorizada
# TIKTOK_OPEN_ID=tu_tiktok_open_id
# Opcional: se muestra en /conectar_tiktok y /redes
# TIKTOK_USERNAME=@MiUsuario
# Solo se usa si tu app exige redirect_uri también en el flujo QR.
# Normalmente el flujo QR no lo necesita.
# TIKTOK_QR_REDIRECT_URI=
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Archivo donde se guardan los tokens (se crea solo)
# SOCIAL_TOKENS_FILE=social_tokens.json

# True para validar sin publicar en YouTube/TikTok
SOCIAL_DRY_RUN=False
